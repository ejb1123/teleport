<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements of Teleport.app's main executable
     (tools/macos-app.sh). Not sandboxed: Developer ID distribution. -->
<plist version="1.0"><dict>
  <!-- Microphone passthrough to the remote computer (NSMicrophoneUsageDescription). -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- GStreamer's ORC compiles small SIMD kernels at run time (MAP_JIT). -->
  <key>com.apple.security.cs.allow-jit</key><true/>
</dict></plist>
